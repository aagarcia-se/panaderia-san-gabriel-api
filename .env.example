#Ambiente
APP_ENV=development
SERVER_PORT=3000

#Observabilidad
APP_NAME=san-gabriel-api
APP_SERVICE=api
LOG_LEVEL=debug
OBSERVABILITY_ENABLED=false

#Base de datos - desarrollo
DB_URL_DEV=
DB_TOKEN_DEV=

#Base de datos - staging
DB_URL_PIL=
DB_TOKEN_PIL=

#Base de datos - produccion
DB_URL_PROD=
DB_TOKEN_PROD=

#Secret keys - todos los ambientes
JWT_SECRET=
JWT_EXPIRES_IN=1h

#Better Stack
BETTER_STACK_INGESTING_HOST=
BETTER_STACK_SOURCE_TOKEN=

#SMTP (Gmail)
#Usa una contraseña de aplicacion generada en https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
